# Required — powers the AI analyst
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the analyst (check docs.claude.com for current model names)
MODEL=claude-sonnet-5

# Season being drafted (last season stats auto-derive from this)
SEASON=2026

# ESPN live draft sync (private leagues need cookies — see README)
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Railway sets PORT automatically; local default 3000
# PORT=3000

# App access password (required) — pick something long; sessions last 30 days
APP_PASSWORD=

# Optional: separate session-signing secret (random 32+ chars). Derived from APP_PASSWORD if unset.
SESSION_SECRET=
